# Example environment file. Do not put real secrets here.
# Copy to `.env` for local development; `.env` is ignored by git.

# kvenv / Azure Key Vault reference style:
# OPENAI_API_KEY=kv://my-key-vault/OPENAI-API-KEY
# or with KEYVAULT set outside the repo:
# OPENAI_API_KEY=kv://OPENAI-API-KEY

# 1Password `op run` / dotenv placeholder style:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=

# Non-secret local defaults are OK here.
# ENVIRONMENT=development
# LOG_LEVEL=INFO

# Snowflake baseline export configuration for:
# uv run aots-report export-snowflake --env-file .env --plan-only
#
# Keep real values in `.env` or another ignored env file, not in this example.
# Do not pass passwords on the command line; shell history can leak them.
# SNOWFLAKE_ACCOUNT=
# SNOWFLAKE_USER=
# SNOWFLAKE_PASSWORD=
# SNOWFLAKE_WAREHOUSE=
# SNOWFLAKE_DATABASE=AOTS
# SNOWFLAKE_SCHEMA=TC_ECMWF

# Optional: set when your Snowflake account requires a role override.
# SNOWFLAKE_ROLE=
